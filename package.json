{
  "name": "asba",
  "productName": "ASBA",
  "version": "1.0.0",
  "private": true,
  "description": "ASBA - AI 安全前沿研究博客聚合与翻译平台",
  "author": "ASBA",
  "main": "src/main/main.js",
  "scripts": {
    "vite": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "dev": "vite build && electron .",
    "predist": "node scripts/make-license-rtf.js && node scripts/patch-nsis-zh.js",
    "dist": "vite build && node scripts/check-renderer-build.js && node scripts/clean-seed.js && electron-builder --win nsis",
    "dist:dir": "vite build && node scripts/check-renderer-build.js && node scripts/clean-seed.js && electron-builder --win --dir"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "dompurify": "3.3.1",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.asba.desktop",
    "productName": "ASBA",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "seed.db",
        "to": "seed.db"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.rtf",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASBA",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "ASBA v${version}_setup.exe"
    }
  }
}
